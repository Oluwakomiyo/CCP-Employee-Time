PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (required; no wildcard)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Company timezone: workdays are the local date at clock-in. Timestamps are stored in UTC.
COMPANY_TZ=Africa/Lagos

# PostgreSQL connection string: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://ccp:ccp@localhost:5432/ccp_time?schema=public"
# Separate database used only by `npm test` (it is wiped between test runs)
DATABASE_URL_TEST="postgresql://ccp:ccp@localhost:5432/ccp_time_test?schema=public"

# Required. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Cookie domain for session cookies (leave empty for localhost)
COOKIE_DOMAIN=
