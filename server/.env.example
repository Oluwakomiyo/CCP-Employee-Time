PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection string: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timemanagement_db?schema=public"

JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d